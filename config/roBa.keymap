#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    //automouse-layer = <4>;
    scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };

        muhennkann {
            bindings = <&to_layer_0 INT_MUHENKAN>;
            key-positions = <11 10>;
        };

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
        };

        eq {
            bindings = <&kp EQUAL>;
            key-positions = <24 25>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        email: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp H &kp I &kp R &kp O &kp Y &kp U &kp K &kp I &kp LS(INT_RO) &kp K &kp O &kp N &kp D &kp O &kp LS(INT_RO) &kp A &kp H &kp LBKT &kp M &kp A &kp I &kp L &kp DOT &kp T &kp O &kp Y &kp O &kp T &kp A &kp DOT &kp C &kp O>;
            label = "NEW_MACRO";
        };

        v6: v6 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(N1) &kp X &kp N9 &kp LS(R) &kp N6 &kp LS(Q) &kp N6 &kp H &kp G &kp LS(N9) &kp N9 &kp LS(M)>;
            label = "V6";
        };

        Macro2: Macro2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp B &kp P &kp N0 &kp N9 &kp F &kp F &kp B &kp I &kp R>;
            label = "MACRO2";
        };

        Macro1: Macro1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(U) &kp N5 &kp LS(F) &kp LS(F) &kp N7 &kp LS(V) &kp SINGLE_QUOTE &kp F &kp LS(Z) &kp H &kp LS(A) &kp N8 &kp K &kp LS(INT_RO) &kp LS(K)>;
            label = "MACRO1";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&lt 6 Q        &kp W         &kp E         &kp R                      &kp T                                             &kp Y        &kp U  &lt 5 I    &kp O    &kp P
&kp A          &kp S         &kp D         &kp F                      &kp G        &kp C                 &kp PAGE_UP    &kp H        &kp J  &kp K      &kp L    &mt LEFT_ALT MINUS
&kp Z          &kp X         &kp C         &kp V                      &kp B        &kp ESCAPE            &kp PAGE_DOWN  &kp N        &kp M  &kp COMMA  &kp DOT  &mt RIGHT_SHIFT TAB
&mt LCTRL TAB  &kp LEFT_ALT  &kp LEFT_GUI  &mt LEFT_SHIFT LANGUAGE_1  &lt 1 SPACE  &lt 2 LANGUAGE_2      &kp BACKSPACE  &lt 3 ENTER                             &kp DEL
            >;

            sensor-bindings = <&inc_dec_kp A B>;
        };

        FUNCTION {
            bindings = <
&kp EXCLAMATION  &kp LS(N2)        &kp HASH      &kp DOLLAR  &kp PERCENT                             &Macro1    &Macro2         &v6       &email    &none
&kp LS(N6)       &kp LS(N7)        &kp EQUAL     &kp LS(N8)  &kp LS(N9)   &trans      &kp LS(EQUAL)  &kp MINUS  &mkp MB1        &mkp MB2  &mkp MB3  &none
&kp SEMICOLON    &kp SINGLE_QUOTE  &kp QUESTION  &kp RBKT    &kp BSLH     &trans      &trans         &kp LBKT   &kp LS(INT_RO)  &mkp MB4  &mkp MB5  &none
&kp PLUS         &kp INT_YEN       &kp SLASH     &trans      &trans       &trans      &trans         &trans                                         &none
            >;
        };

        NUM {
            bindings = <
&none   &none   &none   &none       &none                                        &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp EQUAL             &kp LS(MINUS)
&none   &none   &none   &kp LS(N8)  &kp LS(N9)        &none       &kp BACKSLASH  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp LS(SINGLE_QUOTE)  &kp SLASH
&none   &none   &none   &kp LT      &kp GREATER_THAN  &none       &kp INT_YEN    &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp COLON             &kp MINUS
&trans  &trans  &trans  &trans      &trans            &trans      &kp DOT        &kp N0                                                          &kp LS(INT_YEN)
            >;
        };

        ARROW {
            bindings = <
&kp ESCAPE      &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &trans                       &trans  &trans        &kp LG(UP_ARROW)  &trans         &trans
&kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END  &trans      &trans  &trans  &kp LG(LEFT)  &kp LG(DOWN)      &kp LG(RIGHT)  &trans
&kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &trans          &kp LG(LS(RIGHT_ARROW))  &trans   &trans      &trans  &trans  &trans        &trans            &trans         &trans
&trans          &trans                  &trans          &trans                   &trans   &trans      &trans  &trans                                                 &kp LG(LS(S))
            >;

            sensor-bindings = <&inc_dec_kp A B>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans        &trans        &trans        &trans                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans                                                  &bt BT_CLR_ALL
            >;
        };
    };
};
